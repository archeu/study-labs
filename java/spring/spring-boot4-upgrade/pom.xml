<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.archeu.labs</groupId>
    <artifactId>java-labs</artifactId>
    <version>1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>spring-spring-boot4-upgrade</artifactId>
  <name>改个版本号，付款就 400 了：Spring Boot 3 到 4 升级</name>
  <!--
    同一个交易靶场付款接口，用 profile 切三种构建：
      -Pboot3            Boot 3.5.16 + Jackson 2（升级前，默认）
      -Pboot4            Boot 4.1.2  + Jackson 3（按迁移指南改完）
      -Pboot4-naive      只把版本号改成 4.1.2，代码和三方 starter 都不动（看编译器报什么）
    共用代码在 src/main/java；两边写法不同的那一个类分别在 src/boot3/java、src/boot4/java。
  -->
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>${mybatis-starter.version}</version></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId></dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>boot3</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties>
        <spring-boot.version>3.5.16</spring-boot.version>
        <mybatis-starter.version>3.0.5</mybatis-starter.version>
        <extra.src>src/boot3/java</extra.src>
      </properties>
      <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>boot4-naive</id>
      <properties>
        <spring-boot.version>4.1.2</spring-boot.version>
        <mybatis-starter.version>3.0.5</mybatis-starter.version>
        <extra.src>src/boot3/java</extra.src>
      </properties>
      <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
      </dependencies>
    </profile>
    <profile>
      <id>boot4</id>
      <properties>
        <spring-boot.version>4.1.2</spring-boot.version>
        <mybatis-starter.version>4.1.0</mybatis-starter.version>
        <extra.src>src/boot4/java</extra.src>
      </properties>
      <dependencies>
        <!-- 4.0 起 starter-web 改名 starter-webmvc（旧名还在，但已弃用） -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <!-- 模拟“某个三方 SDK 把 Jackson 2 带了进来”：Boot 4 仍管理 Jackson 2 的版本，两套可以并存 -->
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration><parameters>true</parameters></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-version-src</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
            <configuration><sources><source>${extra.src}</source></sources></configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
