<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- 父工程：IDEA 打开本文件即可导入全部实验。每个实验是一个子模块：<主题>/<页面文件名>/ -->
  <groupId>io.github.archeu.labs</groupId>
  <artifactId>java-labs</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <properties>
    <!-- 默认 JDK 17；页面⑤按 JDK 8 写法的模块覆盖成 8，用虚拟线程的覆盖成 21 -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <!-- new_lab.py 会在这里追加 <module> -->
    <module>java/pano-j01-order-object-life</module>
    <module>javase/oop-generics-erasure</module>
    <module>javase/collections-choose</module>
    <module>javase/hashmap-internals</module>
    <module>javase/hashmap-relatives</module>
    <module>javase/lambda-stream-record</module>
    <module>javase/exception-reflection-proxy</module>
    <module>javase/io-nio-basics</module>
    <module>javase/algorithms-everyday</module>
    <module>java/pano-j02-order-in-threadpool</module>
    <module>juc/thread-state-context-switch</module>
    <module>juc/jmm-jcstress-cache</module>
    <module>juc/synchronized-cas-atomic</module>
    <module>juc/aqs-rwlock-jfr</module>
    <module>juc/chm-blocking-queue</module>
    <module>juc/threadpool-tuning</module>
    <module>juc/threadlocal-leak</module>
    <module>juc/completablefuture-orchestration</module>
    <module>juc/virtual-threads-pinning</module>
    <module>java/pano-j03-object-new-to-gc</module>
    <module>jvm/jvm-object-new-layout</module>
    <module>jvm/jvm-gc-log-tuning</module>
    <module>jvm/jvm-classloading</module>
    <module>jvm/jvm-jit-escape</module>
    <module>jvm/jvm-troubleshooting</module>
    <module>jvm/jvm-container</module>
    <module>java/pano-j04-order-calls-inventory</module>
    <module>network/tcp-handshake-timewait-framing</module>
    <module>network/netty-eventloop-pipeline-bytebuf</module>
    <module>network/rpc-serialization-discovery-lb</module>
    <module>network/http-client-pool-timeouts</module>
    <module>java/pano-j05-request-through-spring</module>
    <module>spring/spring-bean-proxy-swap</module>
    <module>spring/spring-boot-bean-ledger</module>
    <module>spring/spring-aop-chain</module>
    <module>spring/spring-tx-propagation</module>
    <module>mybatis/mybatis-result-mapping</module>
    <module>spring/spring-mvc-dispatch</module>
    <module>spring/spring-security-token</module>
    <module>spring/spring-boot4-upgrade</module>
    <module>spring/spring-testing</module>
    <module>java/pano-j06-update-to-disk</module>
    <module>database/mysql-index-bplustree</module>
    <module>database/mysql-explain-tuning</module>
    <module>database/mysql-lock-wait-deadlock</module>
    <module>database/mysql-redo-undo-binlog</module>
    <module>database/mysql-replication-lag</module>
    <module>database/mysql-online-ddl</module>
    <module>database/db-pool-tx-perf-hot-row</module>
    <module>database/mysql-84-upgrade</module>
    <module>database/pg-mvcc-vacuum-jsonb</module>
    <module>database/mysql-vs-pg-pgvector</module>
    <module>java/pano-j07-product-detail-cache</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.1</version>
        </plugin>
        <plugin>
          <!-- 命令行运行：mvn -q -pl <模块> compile exec:java -Dexec.mainClass=<类> -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
